<?xml version="1.0" encoding="utf-8"?>
<!-- The hub's watch API is plain HTTP on the LAN or a Tailscale address (100.x, which Tailscale already encrypts).
     A domain-config can't name IP ranges, so cleartext is allowed; the app talks only to the hub URL set in Settings. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
